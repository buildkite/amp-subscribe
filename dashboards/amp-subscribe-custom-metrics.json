      },
      "description": "amp_subscribe_subscriptions gauge, split by app and target_type",
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_on_fly"
          },
          "expr": "amp_subscribe_subscriptions{app=~\"$app\"}",
          "instant": true,
          "legendFormat": "{{app}} - {{target_type}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Current subscriptions by target type",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_on_fly"
      },
